# Python 캐시
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg

# 가상환경
.venv/
venv/
env/

# PyInstaller 빌드 캐시 (임시 빌드 중간 산출물)
build/
*.manifest
*.spec.bak

# 임시 파일
*.tmp.txt
*.tmp.wav
temp_*.wav

# IDE & 에디터
.vscode/
.idea/
*.swp
*.swo

# OS 파일
Thumbs.db
Desktop.ini
.DS_Store

# 모델 캐시 (대용량 가중치 파일)
models/
*.bin
*.pt

# 설정 파일 (개인 API 토큰 포함 가능)
config.json

# 로그 파일
*.log

# 배포용 실행 파일(.exe)은 반드시 Git에 포함 (절대 제외 금지)
!*.exe
!**/*.exe

# 단, 100MB를 초과하는 외부 바이너리는 제외 (GitHub 파일당 100MB 제한)
ffmpeg.exe
ffprobe.exe
**/ffmpeg.exe
**/ffprobe.exe
